# Lingkungan Aplikasi
NODE_ENV=development
PORT=3000
APP_PORT=3001

# Pengaturan Database MySQL (Kompatibel SIMKhanza)
# Untuk Docker Compose: gunakan DB_HOST=db
# Untuk local npm run dev: gunakan DB_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sik
DB_USER=coda_user
DB_PASSWORD=coda_secret_password
DB_CONNECTION_LIMIT=10

# Root Password Database (Hanya untuk inisialisasi Docker MySQL)
MYSQL_ROOT_PASSWORD=coda_root_password

# Identitas Produk
NEXT_PUBLIC_APP_NAME=e-clinic-coda
NEXT_PUBLIC_APP_VERSION=0.1.0

